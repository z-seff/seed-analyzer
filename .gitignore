# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# Сгенерированные отчёты — содержат адреса, балансы и, при --with-keys,
# приватные ключи. Не должны попадать в репозиторий.
*.xlsx

# Seed-фраза, если она была сохранена в файл для -f/--mnemonic-file
*.seed
seed*.txt
mnemonic*.txt

# macOS
.DS_Store

# IDE
.vscode/
.idea/
.claude/

# Офлайн-копия генератора iancoleman.io — большой файл (4.5 МБ),
# кодом не используется, служит только справочником при разработке.
bip39-standalone-*.html
